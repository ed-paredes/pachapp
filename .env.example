# Copy to `.env` at the repo root and fill in the required values.
# Every backend key is read by shared/settings.py (prefix PACHAPP_).
# See docs/specs/01-dev-tooling.md for details.

# --- Data (D14): must live on the WSL2 ext4 filesystem, never under /mnt/* ---
PACHAPP_DATA_DIR=~/pachapp-data
# PACHAPP_DB_PATH=~/pachapp-data/db/pachapp.sqlite3
# PACHAPP_IMAGES_ROOT=~/pachapp-data/images

# --- API ---
PACHAPP_API_HOST=0.0.0.0
PACHAPP_API_PORT=8000
# Add your LAN origin so Expo web on another device can call the API (D15).
PACHAPP_CORS_ORIGINS=["http://localhost:8081"]

# --- Vision LLM fallback (optional, off by default; see below) ---
# Required only when PACHAPP_ML_LLM_FALLBACK=true (VIS-REQ-021). Pin an exact
# model version, never a "latest" alias (D11).
# PACHAPP_LLM_PROVIDER=
# PACHAPP_LLM_MODEL_ID=
# PACHAPP_LLM_API_KEY=

# --- Worker and images ---
PACHAPP_WORKER_POLL_INTERVAL_MS=500
PACHAPP_DB_BUSY_TIMEOUT_MS=5000
PACHAPP_UPLOAD_MAX_PX=2048
PACHAPP_THUMB_PX=640

# --- Local vision (08-local-vision.md) ---
# PACHAPP_ML_DEVICE=auto
# PACHAPP_ML_CACHE_DIR=~/pachapp-data/models
# Default background-removal model, MIT-licensed. RMBG-2.0 is NOT the
# default (VIS-REQ-001): its license forbids commercial use. Set
# PACHAPP_ML_BG_MODEL=rmbg-2.0 only for strictly personal use.
# PACHAPP_ML_BG_MODEL=birefnet-general-lite
# Use an fp16 copy of the background model, only when the device is cuda
# (cpu/mps keep fp32). Converted once by `make ml-preload`; needed to fit the
# 6 GB reference GPU and meet VIS-REQ-026.
# PACHAPP_ML_BG_FP16=true
# PACHAPP_ML_EMBED_MODEL=hf-hub:Marqo/marqo-fashionSigLIP
# Pinned commit of PACHAPP_ML_EMBED_MODEL on the Hugging Face Hub (VIS-REQ-002,
# analogous to D11): required, no "latest" alias, so existing embeddings stay
# comparable across worker restarts. Current HEAD of Marqo/marqo-fashionSigLIP
# as of 2026-09-29; re-pin deliberately to upgrade (the `make reembed` target that re-embeds
# existing garments arrives with 08-local-vision.md step 6, VIS-REQ-009).
PACHAPP_ML_EMBED_REVISION=c56244cc94f92419e8369fa71efdaf403b124ce8
# PACHAPP_ML_MARGIN_THRESHOLD=0.15
# PACHAPP_ML_KNN_K=7
# PACHAPP_ML_KNN_MIN_VERIFIED=30
# PACHAPP_ML_LLM_FALLBACK=false
# PACHAPP_ML_EVAL_DIR=~/pachapp-data/eval/garments

# --- App (Expo) ---
# The API as seen from the device running the app. Use the PC's LAN IP for a phone.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000
